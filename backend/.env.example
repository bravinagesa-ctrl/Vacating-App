# ---------- Django ----------
DJANGO_SECRET_KEY=PASTE_A_LONG_RANDOM_STRING_HERE
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL + PostGIS ----------
DB_NAME=hama
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Windows only: paths to GDAL / GEOS DLLs if Django cannot find them (leave blank on Linux/macOS)
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# ---------- Geocoding (place search) ----------
# Leave blank to use free OpenStreetMap Nominatim. Paste a key to use Google Geocoding instead.
GOOGLE_MAPS_API_KEY=
NOMINATIM_USER_AGENT=hama-house-search/1.0 (contact: PASTE_YOUR_EMAIL_HERE)

# ---------- Africa's Talking (SMS) ----------
# Use AT_USERNAME=sandbox while testing.
AT_USERNAME=sandbox
AT_API_KEY=PASTE_AFRICAS_TALKING_API_KEY_HERE
AT_SENDER_ID=

# ---------- M-Pesa Daraja (STK Push) ----------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=PASTE_DARAJA_CONSUMER_KEY_HERE
MPESA_CONSUMER_SECRET=PASTE_DARAJA_CONSUMER_SECRET_HERE
MPESA_SHORTCODE=174379
MPESA_PASSKEY=PASTE_DARAJA_PASSKEY_HERE
# Public HTTPS URL of this backend (use ngrok while developing). No trailing slash.
MPESA_CALLBACK_BASE_URL=https://PASTE-YOUR-PUBLIC-URL-HERE
# Any long random string. It becomes part of the callback URL so strangers cannot fake payments.
MPESA_CALLBACK_TOKEN=PASTE_ANOTHER_LONG_RANDOM_STRING_HERE
FEATURED_LISTING_FEE_KES=500
FEATURED_LISTING_DAYS=30
