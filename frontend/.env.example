# Backend API base URL (no trailing slash)
VITE_API_URL=http://127.0.0.1:8000/api

# Map tiles. Default is OpenStreetMap, which is fine for development and light traffic.
# For production, use a tile provider and paste its URL here, for example MapTiler:
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=PASTE_MAPTILER_KEY_HERE
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
